# Disable script execution in uploads directory
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .shtml .cgi .pl
SetHandler default-handler

<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|shtml|cgi|pl|sh|bash|exe|py|rb|js|svg)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
