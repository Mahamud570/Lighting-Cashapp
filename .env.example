NODE_ENV=production
PORT=3000

# Required in production. Generate at least 64 random characters.
JWT_SECRET=replace-with-a-long-random-secret
PUBLIC_BASE_URL=https://payments.example.com
ALLOWED_ORIGINS=https://payments.example.com

# Set to 1 only behind a trusted reverse proxy such as cPanel/Passenger.
TRUST_PROXY=1

# Used only to create the first owner if the database has no matching username.
# Remove these three values after the owner has been created and the password changed.
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-at-least-12-characters

# Demo checkout is off in production by default.
ALLOW_DEMO_PAYMENTS=0

# IP geolocation. When WHOER_API_KEY is set, the server uses Whoer Live V2.
GEOIP_ENABLED=1
GEOIP_ENDPOINT=https://www.whoer.live/api/v2/bulk-scan
WHOER_API_KEY=
# Daily database backups are stored outside the web application directory.
BACKUP_ENABLED=1
BACKUP_DIR=/home/account/lightning-pay-backups
# Optional override when the host does not expose mariadb-dump/mysqldump normally.
MYSQLDUMP_PATH=/usr/bin/mariadb-dump
# Durable cPanel MariaDB storage
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=portalca_lightning_pay
DB_USER=portalca_portalca_lightning_app
DB_PASSWORD=
DB_POOL_SIZE=8
# Optional Release 1 hardening. Generate one random 32-byte value and keep it
# permanently in the hosting environment before encrypting stored credentials.
CREDENTIAL_ENCRYPTION_KEY=
APP_LOG_RETENTION_DAYS=14
HEALTH_CACHE_MS=300000
