# ============================================================
#  Lightning Cash App — Environment Configuration
#  Copy this file to .env and fill in your credentials.
#  ⚠️  NEVER commit the real .env file to version control.
# ============================================================

# --- Server ---
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_random_string_min_32_chars
JWT_SECRET=change_this_to_another_random_secret

# --- Lightning Gateway (choose one) ---
# Blink
BLINK_API_KEY=
BLINK_ACCOUNT_ID=
BLINK_BTC_WALLET_ID=
BLINK_USD_WALLET_ID=

# LNbits (optional)
LNBITS_URL=
LNBITS_API_KEY=

# Alby (optional)
ALBY_API_KEY=

# --- Binance Auto-Sweep ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram Bot Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
